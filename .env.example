# Copy to .env.local. Keep real credentials out of Git and chat.
# Explicit opt-in is required when hosting this FIXED-OTP PROTOTYPE.
AUTH_MODE=prototype
PROTOTYPE_OTP=123456
# Set a random secret of at least 32 characters; mandatory when hosted.
AUTH_COOKIE_SECRET=

# Local development without these uses .data/login-users.json.
# Hosting requires Supabase: run supabase/migrations/202610040001_login_users.sql.
SUPABASE_URL=
# Server-side secret key or legacy service_role key; NEVER use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: menu/auth work without Groq, with a deterministic chat fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Local text extraction runs before Groq receives any document content.
HEALTHNEST_PYTHON_PATH=python3
# Scanned PDFs/images need local OCR. Configure Poppler + Tesseract; unextractable scans fail closed.
PDFTOPPM_PATH=pdftoppm
TESSERACT_PATH=tesseract

# Sarathi hybrid repository. Enable Drive API and Calendar API; create a Web OAuth client.
# Add this exact authorized redirect: http://localhost:8080/api/google/callback
APP_URL=http://localhost:8080
# Local: leave blank/local. Vercel: set supabase and run 202610050005_vercel_demo.sql.
HEALTHNEST_DATA_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail app password, NOT the normal account password. Enable Gmail 2-step verification.
SMTP_USER=kulkarnikaustubh172@gmail.com
SMTP_PASS=

# prototype = timestamped checkbox consent, NOT an eSignature.
# setu_esign = access remains pending until Setu confirms the owner signed.
SHARING_CONSENT_MODE=prototype
SETU_ESIGN_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# Setu requires a PUBLIC HTTPS URL; localhost is not suitable for this callback.
SETU_REDIRECT_URL=

# Imported Gnani voice / Twilio trial calls / Delhivery Maps configuration.
# PUBLIC_BASE_URL must tunnel to localhost:8080 (e.g. ngrok http 8080).
GNANI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEMO_RECIPIENT=
PUBLIC_BASE_URL=
DELHIVERY_MAPS_TOKEN=
